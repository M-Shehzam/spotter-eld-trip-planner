# --- Core -------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
TIME_ZONE=America/Chicago

# --- Database ---------------------------------------------------------
# Unset falls back to a SQLite file, so a fresh clone runs with no setup.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- CORS -------------------------------------------------------------
# Set this in production to the deployed frontend origin.
# CORS_ALLOWED_ORIGINS=https://spotter-eld-trip-planner.vercel.app
# Vercel preview deployments get a new subdomain each time.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://spotter-eld-trip-planner-.*\.vercel\.app$

# --- Routing ----------------------------------------------------------
# OSRM's demo server needs no key. Override to point at your own instance.
OSRM_BASE_URL=https://router.project-osrm.org
# Consulted only after the primary fails.
OSRM_FALLBACK_URL=
ROUTING_TIMEOUT_SECONDS=20
ROUTING_RETRIES=2

# OSRM's demo profile is a car. This factor brings the estimate down to a
# realistic Class 8 average of roughly 55-58 mph.
TRUCK_SPEED_FACTOR=1.15

# --- Hours of service (49 CFR 395.3, property-carrying driver) ---------
# Exposed so the rules can be adjusted without touching code. The defaults
# are the regulation.
HOS_DRIVING_LIMIT_HOURS=11
HOS_DUTY_WINDOW_HOURS=14
HOS_DRIVING_BEFORE_BREAK_HOURS=8
HOS_BREAK_HOURS=0.5
HOS_RESET_HOURS=10
HOS_CYCLE_LIMIT_HOURS=70
HOS_CYCLE_DAYS=8
HOS_RESTART_HOURS=34

# --- Trip assumptions stated in the brief -----------------------------
PICKUP_HOURS=1
DROPOFF_HOURS=1
FUEL_INTERVAL_MILES=1000
FUEL_STOP_HOURS=0.5

# --- Start-up ---------------------------------------------------------
# Load the gazetteer at boot rather than on the first request. Set in
# production; leave off locally so management commands stay quick.
WARM_INDEX_ON_START=0
